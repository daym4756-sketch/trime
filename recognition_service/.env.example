# ========================================
# TRIME Backend Service Environment Config
# Copy file ini menjadi .env dan isi nilai aslinya
# ========================================

# ─── API Settings ───
API_HOST=0.0.0.0
API_PORT=8001
API_SECRET=trime_super_secret_key_ganti_ini

# ─── WhatsApp Gateway (Pilih SALAH SATU) ───
# Rekomendasi untuk Indonesia: FONNTE (https://fonnte.com)
# Alternatif: Whacenter, Qontak, Twilio

# OPSI 1: FONNTE (Termurah & stabil untuk ID)
WA_PROVIDER=fonnte
WA_FONNTE_TOKEN=YOUR_FONNTE_DEVICE_TOKEN
WA_FONNTE_BASE_URL=https://api.fonnte.com/send

# OPSI 2: Whacenter
# WA_PROVIDER=whacenter
# WA_WHACENTER_TOKEN=YOUR_WHACENTER_TOKEN
# WA_WHACENTER_BASE_URL=https://app.whacenter.com/api

# OPSI 3: Twilio (International)
# WA_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID
# TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
# TWILIO_WA_FROM=whatsapp:+14155238886

# ─── Supabase Config (Untuk sync booking) ───
SUPABASE_URL=https://ttlladewtuhorjraipva.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ─── Reminder Settings ───
REMINDER_MINUTES_BEFORE=30
SCHEDULER_ENABLED=true

# ─── Feature Toggles ───
ENABLE_WA_NOTIF=true
ENABLE_FACE_ANALYSIS=true
